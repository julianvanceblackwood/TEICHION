      "epoch": 0,
      "sequence": 1,
      "payload_hex": "616263",
      "payload_length": 3,
      "previous_seal_hex": "1111111111111111111111111111111111111111111111111111111111111111",
      "canonical_length": 75,
      "canonical_hex": "5445494348494f4e2d5345414c2d56310101010000000000000000000000000000000001000000031111111111111111111111111111111111111111111111111111111111111111616263",
      "sha256_fixture_fingerprint": "9359b5c0f4161dce9385e9c9601c61d81f7ffcbbe5f83f998f9e025d7be13d8d"
